# This is a public site URL, not a secret. Use the deployed API for device tests.
EXPO_PUBLIC_API_BASE_URL=https://ixzzy.vercel.app

# These are Google OAuth client IDs (public identifiers), never client secrets.
# Use the existing Google Web OAuth client ID for the server-audience token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud iOS OAuth client ID for bundle ID com.ixzzy.store.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
