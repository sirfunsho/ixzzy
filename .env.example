NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js / Google OAuth. Never prefix secrets with NEXT_PUBLIC_.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional comma-separated Google OAuth client IDs for native app sign-in.
GOOGLE_MOBILE_CLIENT_IDS=

# Optional. Omit until order-confirmation email is enabled.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# Optional; use https://api.eu.mailgun.net for EU region accounts.
MAILGUN_API_BASE_URL=https://api.mailgun.net
